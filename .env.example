# ---------------------------------------------------------------------------
# Nimbus Drive — environment variables
# Copy to `.env` and fill in the values. Never commit the real `.env` file.
# ---------------------------------------------------------------------------

# --- Core -----------------------------------------------------------------
NODE_ENV=development

# PostgreSQL connection string (docker-compose provides a local instance).
DATABASE_URL="postgresql://nimbus:nimbus@localhost:5432/nimbus_drive?schema=public"

# Secret used by NextAuth to sign session cookies.
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-with-a-32-character-minimum-secret"
AUTH_TRUST_HOST=true

# Public URL of the application (used to build share links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Nimbus Drive"

# --- Storage --------------------------------------------------------------
# `local` stores files on disk (development), `s3` uses S3 / Supabase Storage.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=".storage/uploads"

# Secret used to sign local-storage upload/download grants.
# Generate with: openssl rand -hex 32
UPLOAD_SIGNING_SECRET="change-me-with-at-least-16-characters"

# S3-compatible object storage (AWS S3, Cloudflare R2, Supabase Storage, ...).
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
# Optional custom endpoint, e.g. https://<project>.supabase.co/storage/v1/s3
AWS_S3_ENDPOINT=""
AWS_S3_FORCE_PATH_STYLE=false

# --- Rate limiting --------------------------------------------------------
# Optional. Without these values an in-memory limiter is used, which is fine
# for a single instance but resets on deploy.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
